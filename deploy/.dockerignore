# This file must live at the REPO ROOT to take effect for `docker build .`.
# Copy it there:  cp deploy/.dockerignore .dockerignore
#
# Keeps dev-only, large, or secret material OUT of the production image.
.git
.github
.idea
.grunt
.phpunit.cache
node_modules
**/node_modules
SecureFood School/
# Exclude everything under deploy/ EXCEPT the files the Dockerfile copies.
# (Use deploy/* not deploy/ so specific files can be re-included below.)
deploy/*
!deploy/moodle.prod.ini
!deploy/config.prod.php
!deploy/nginx.prod.conf
# Never let secrets or the real env into the build context.
deploy/secrets
deploy/.env.prod
backups/
moodledata/
.env
.env.*
*.log
composer.phar
docker-compose.yml
Makefile
securefood-school-ai-agent-prompt.txt
**/tests/
**/*.md
