# This file must live at the REPO ROOT to take effect for `docker build .`.
# Copy it there:  cp deploy/.dockerignore .dockerignore
#
# Keeps dev-only, large, or secret material OUT of the production image.
.git
.github
.idea
.grunt
.phpunit.cache
node_modules
**/node_modules
SecureFood School/
# Keep deploy/ IN the build context (the Dockerfile copies three files from it,
# and the deploy/ dir is later removed from the image by `rm -rf …/deploy`).
# Do NOT blanket-exclude deploy/ — BuildKit negation (!deploy/x) is unreliable.
# Only keep secrets and the real env OUT of the context:
deploy/secrets
deploy/.env.prod
backups/
moodledata/
.env
.env.*
*.log
composer.phar
docker-compose.yml
Makefile
securefood-school-ai-agent-prompt.txt
**/tests/
**/*.md
