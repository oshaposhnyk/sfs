# Copy to .env.prod and fill in. NON-SECRET values only — passwords live in
# ./secrets/* as Docker secret files. Keep .env.prod out of git.

# Fixed project name so volume names are stable (sfs_moodledata, sfs_mysql_data…)
# and match backup.sh regardless of the directory you run compose from.
COMPOSE_PROJECT_NAME=sfs

# Public domain (already delegated to this server's IP) and ACME contact.
MOODLE_DOMAIN=lms.example.edu.ua
ACME_EMAIL=ops@example.edu.ua

# Database (name + user are not secret; the password is a Docker secret).
MOODLE_DB_NAME=moodle
MOODLE_DB_USER=moodle

# Image naming — tag every deploy with the git short SHA for clean rollbacks.
IMAGE_PREFIX=sfs
IMAGE_TAG=latest
