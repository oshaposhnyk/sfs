{{!
    @template theme_securefood/plan_context

    Learner's plan context above course content (Phase 6.1).

    Example context (json):
    {
        "planname": "Analyst-Translator Pathway",
        "positionlabel": "Course 1 of 4",
        "percentage": 40
    }
}}
<div class="sfs-plancontext">
    <a class="sfs-plancontext__chip" href="{{config.wwwroot}}/local/learningplans/my.php">
        <span class="sfs-icon" aria-hidden="true">workspace_premium</span>
        {{planname}}
    </a>
    <span class="sfs-plancontext__pos">{{positionlabel}}</span>
    <progress class="sfs-plancontext__progress" value="{{percentage}}" max="100"
              aria-label="{{#str}}plancontext_progress, theme_securefood{{/str}}">{{percentage}}%</progress>
    <span class="sfs-plancontext__pct">{{percentage}}%</span>
</div>
