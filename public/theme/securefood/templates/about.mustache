{{!
    @template theme_securefood/about

    About the Project hero + KPI row (front page, SecureFood mode).

    Example context (json):
    {
        "kicker": "SecureFood Living Labs",
        "title": "A shield for the food systems of tomorrow",
        "lede": "<p>Learning by sensing.</p>",
        "stats": [{"value": "14", "label": "Living Labs"}],
        "kpis": [{"value": "96%", "label": "Sensor uptime", "sub": "All labs"}]
    }
}}
<section class="sfs-hero">
    <div class="sfs-hero__inner">
        <div class="sfs-hero__body">
            <div class="sfs-hero__kicker">{{kicker}}</div>
            <h2 class="sfs-hero__title">{{title}} {{#titleaccent}}<span class="sfs-hero__accent">{{titleaccent}}</span>{{/titleaccent}}</h2>
            <div class="sfs-hero__lede">{{{lede}}}</div>
        </div>
        <div class="sfs-hero__panel" aria-hidden="true">
            <img class="sfs-hero__logo" src="{{logourl}}" alt="">
        </div>
    </div>
    {{#stats.0}}
        <div class="sfs-hero__stats">
            {{#stats}}
                <div class="sfs-hero__stat">
                    <div class="sfs-hero__value">{{value}}</div>
                    <div class="sfs-hero__label">{{label}}</div>
                </div>
            {{/stats}}
        </div>
    {{/stats.0}}
</section>

<div class="sfs-shield">
    <section class="sfs-shield__card">
        <span class="sfs-shield__chip">{{shieldchip}}</span>
        <h3 class="sfs-shield__title">{{shieldtitle}}</h3>
        <div class="sfs-shield__body">{{{shieldbody}}}</div>
    </section>
    <section class="sfs-layers">
        <h3 class="sfs-layers__title">{{layerstitle}}</h3>
        {{#layers}}
            <div class="sfs-layers__item">
                <span class="sfs-layers__num" aria-hidden="true">{{number}}</span>
                <div>
                    <div class="sfs-layers__name">{{title}}</div>
                    <div class="sfs-layers__text">{{text}}</div>
                </div>
            </div>
        {{/layers}}
    </section>
</div>

{{#showapproach}}
    <section class="sfs-approach">
        <div class="sfs-approach__grid">
            <div class="sfs-approach__intro">
                <div class="sfs-approach__kicker">{{approachkicker}}</div>
                <h3 class="sfs-approach__title">{{approachtitle}}</h3>
                <div class="sfs-approach__body">{{{approachbody}}}</div>
            </div>
            <div class="sfs-approach__steps">
                {{#approachsteps}}
                    <article class="sfs-approach__step">
                        <div class="sfs-approach__number">{{number}}</div>
                        <h4 class="sfs-approach__step-title">{{title}}</h4>
                        <p class="sfs-approach__step-text">{{text}}</p>
                    </article>
                {{/approachsteps}}
            </div>
        </div>
    </section>
{{/showapproach}}

{{#kpis.0}}
    <div class="sfs-kpi__row">
        {{#kpis}}
            <div class="sfs-kpi">
                <div class="sfs-kpi__head">{{label}}</div>
                <div class="sfs-kpi__value">{{value}}</div>
                {{#sub}}<div class="sfs-kpi__sub">{{sub}}</div>{{/sub}}
            </div>
        {{/kpis}}
    </div>
{{/kpis.0}}

{{#hubs.0}}
    <section class="sfs-hubs">
        <h3 class="sfs-hubs__title">{{hubstitle}}</h3>
        <div class="sfs-hubs__grid">
            <div class="sfs-hubs__map" aria-hidden="true">
                {{#hubs}}
                    {{#onmap}}
                        <span class="sfs-hubs__marker {{#islab}}sfs-hubs__marker--lab{{/islab}}"
                              style="left: {{x}}%; top: {{y}}%;" title="{{name}}"></span>
                    {{/onmap}}
                {{/hubs}}
            </div>
            <div class="sfs-hubs__card">
            <ul class="sfs-hubs__list">
                {{#hubs}}
                    <li class="sfs-hubs__row {{#islab}}sfs-hubs__row--lab{{/islab}}">
                        <span class="sfs-hubs__dot" aria-hidden="true"></span>
                        <span class="sfs-hubs__name">{{name}}</span>
                        {{#country}}<span class="sfs-hubs__country">{{country}}</span>{{/country}}
                        <span class="sfs-hubs__status">
                            {{#islab}}{{#str}}abouthub_lab, theme_securefood{{/str}}{{/islab}}
                            {{^islab}}{{#str}}abouthub_partner, theme_securefood{{/str}}{{/islab}}
                        </span>
                    </li>
                {{/hubs}}
            </ul>
            </div>
        </div>
    </section>
{{/hubs.0}}

{{#feed.0}}
    <section class="sfs-feed">
        <h3 class="sfs-feed__title">{{feedtitle}}</h3>
        <div class="sfs-feed__grid">
            {{#feed}}
                <article class="sfs-feedcard">
                    <div class="sfs-feedcard__thumb sfs-feedcard__thumb--{{variant}}">
                        {{#chip}}<span class="sfs-feedcard__chip">{{chip}}</span>{{/chip}}
                    </div>
                    <div class="sfs-feedcard__body">
                        <h4 class="sfs-feedcard__name">{{title}}</h4>
                        {{#text}}<p class="sfs-feedcard__text">{{text}}</p>{{/text}}
                        {{#time}}<div class="sfs-feedcard__time">{{time}}</div>{{/time}}
                    </div>
                </article>
            {{/feed}}
        </div>
    </section>
{{/feed.0}}
