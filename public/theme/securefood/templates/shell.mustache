{{!
    @template theme_securefood/shell

    SecureFood application shell: sidebar + topbar + content column.

    Context variables required for this template:
    * output - The core renderer for the page
    * bodyattributes - attributes for the body tag as a string of html attributes
    * navsections - sidebar navigation sections
    * crumbs - breadcrumb items
    * contenttopblocks - HTML for the content-top blocks region
    * sidepreblocks - HTML for the blocks region
    * contentbottomblocks - HTML for the content-bottom blocks region
    * hasblocks - true if there are blocks on this page
    * showmaincontent - true when core Moodle page content should be rendered

    Example context (json):
    {
        "sitename": "SecureFood School",
        "output": {
            "doctype": "<!DOCTYPE html>",
            "page_title": "Test page",
            "favicon": "favicon.ico",
            "main_content": "<h1>Content</h1>"
        },
        "bodyattributes": "class=\"sfs-mode\"",
        "navsections": [{"label": "Learning", "haslabel": true, "items": [
            {"title": "Student Lab", "url": "#", "icon": "school", "active": true}
        ]}],
        "crumbs": [{"text": "Dashboard", "url": "#", "last": true}],
        "hascrumbs": true,
        "sidepreblocks": "",
        "hasblocks": false
    }
}}
{{> theme_boost/head }}

<body {{{ bodyattributes }}}>
{{> core/local/toast/wrapper}}

<a class="sfs-skip visually-hidden-focusable" href="#sfs-main">{{#str}}skiptocontent, theme_securefood{{/str}}</a>

{{! Shared polite live region for async status (scheme change, map selection). }}
<div id="sfs-live" class="sfs-live" role="status" aria-live="polite"></div>

{{! Anything core injects here must stay OUTSIDE the .sfs-shell grid container,
    otherwise it becomes a grid item and breaks the two-column placement. }}
<div class="sfs-shell__systemarea">{{{ output.standard_top_of_body_html }}}</div>

{{#courseindex}}
    {{< theme_boost/drawer }}
        {{$id}}theme_boost-drawers-courseindex{{/id}}
        {{$drawerheadercontent}}
            {{> theme_boost/courseindexdrawercontrols}}
        {{/drawerheadercontent}}
        {{$drawerheading}}{{> theme_boost/courseindexdrawerheading}}{{/drawerheading}}
        {{$drawerclasses}}drawer drawer-left sfs-drawer-courseindex {{#courseindexopen}}show{{/courseindexopen}}{{/drawerclasses}}
        {{$drawercontent}}
            {{{courseindex}}}
        {{/drawercontent}}
        {{$drawerpreferencename}}drawer-open-index{{/drawerpreferencename}}
        {{$drawerstate}}show-drawer-left{{/drawerstate}}
        {{$tooltipplacement}}right{{/tooltipplacement}}
        {{$closebuttontext}}{{#str}}closecourseindex, core{{/str}}{{/closebuttontext}}
        {{$closebuttonicon}}
            <span class="dir-rtl-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
            <span class="dir-ltr-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
        {{/closebuttonicon}}
    {{/ theme_boost/drawer}}
{{/courseindex}}
{{#hasblocks}}
    {{< theme_boost/drawer }}
        {{$id}}theme_boost-drawers-blocks{{/id}}
        {{$drawerclasses}}drawer drawer-right sfs-drawer-blocks{{#blockdraweropen}} show{{/blockdraweropen}}{{/drawerclasses}}
        {{$drawercontent}}
            <div class="d-print-none">
                {{{ addblockbutton }}}
                {{{ sidepreblocks }}}
            </div>
        {{/drawercontent}}
        {{$drawerpreferencename}}drawer-open-block{{/drawerpreferencename}}
        {{$forceopen}}{{forceblockdraweropen}}{{/forceopen}}
        {{$drawerstate}}show-drawer-right{{/drawerstate}}
        {{$tooltipplacement}}left{{/tooltipplacement}}
        {{$drawercloseonresize}}1{{/drawercloseonresize}}
        {{$closebuttontext}}{{#str}}closeblockdrawer, core{{/str}}{{/closebuttontext}}
        {{$closebuttonicon}}
            <span class="dir-rtl-hide">{{#pix}} e/sidebar_right, core {{/pix}}</span>
            <span class="dir-ltr-hide">{{#pix}} e/sidebar_left, core {{/pix}}</span>
        {{/closebuttonicon}}
    {{/ theme_boost/drawer}}
{{/hasblocks}}

<div id="page-wrapper" class="sfs-shell">

    {{> theme_securefood/shell_sidebar }}

    <div class="sfs-shell__main">
        {{> theme_securefood/shell_topbar }}

        <div id="page" data-region="mainpage" data-usertour="scroller" class="sfs-shell__page drag-container">
            <div id="topofscroll" class="sfs-shell__content">
                {{{ output.full_header }}}
                {{#secondarymoremenu}}
                    <div class="secondary-navigation d-print-none">
                        {{> core/moremenu}}
                    </div>
                {{/secondarymoremenu}}
                {{#hasdrawertoggles}}
                    <div class="sfs-course-drawertoggles d-flex align-items-center mb-3 gap-2">
                        {{#courseindex}}
                            <button
                                class="btn btn-outline-secondary sfs-btn-courseindex d-inline-flex align-items-center gap-2"
                                data-toggler="drawers"
                                data-action="toggle"
                                data-target="theme_boost-drawers-courseindex"
                                aria-expanded="{{#courseindexopen}}true{{/courseindexopen}}{{^courseindexopen}}false{{/courseindexopen}}"
                            >
                                <span class="sfs-icon">format_list_bulleted</span>
                                <span>{{#str}}opendrawerindex, core{{/str}}</span>
                            </button>
                        {{/courseindex}}
                        {{#hasblocks}}
                            <button
                                class="btn btn-outline-secondary sfs-btn-blockdrawer ms-auto d-inline-flex align-items-center gap-2"
                                data-toggler="drawers"
                                data-action="toggle"
                                data-target="theme_boost-drawers-blocks"
                                aria-expanded="{{#blockdraweropen}}true{{/blockdraweropen}}{{^blockdraweropen}}false{{/blockdraweropen}}"
                            >
                                <span class="sfs-icon">widgets</span>
                                <span>{{#str}}blocks, core{{/str}}</span>
                            </button>
                        {{/hasblocks}}
                    </div>
                {{/hasdrawertoggles}}
                <div id="page-content" class="sfs-shell__pagecontent d-print-block">
                    <div id="region-main-box">
                        {{#hasregionmainsettingsmenu}}
                            <div id="region-main-settings-menu" class="d-print-none">
                                <div>{{{ regionmainsettingsmenu }}}</div>
                            </div>
                        {{/hasregionmainsettingsmenu}}
                        <div id="region-main">
                            {{#hasregionmainsettingsmenu}}
                                <div class="region_main_settings_menu_proxy"></div>
                            {{/hasregionmainsettingsmenu}}
                            {{{ output.course_content_header }}}
                            {{#headercontent}}
                                {{> core/activity_header }}
                            {{/headercontent}}
                            {{#overflow}}
                                <div class="container-fluid tertiary-navigation">
                                    <div class="navitem">
                                        {{> core/tertiary_navigation_selector}}
                                    </div>
                                </div>
                            {{/overflow}}
                            <main id="sfs-main" class="sfs-shell__maincontent" tabindex="-1">
                                {{#abouthtml}}{{{abouthtml}}}{{/abouthtml}}
                                {{#hascontenttopblocks}}
                                    <div class="sfs-shell__blockslot sfs-shell__blockslot--content-top d-print-none">
                                        {{{contenttopaddblockbutton}}}
                                        {{{contenttopblocks}}}
                                    </div>
                                {{/hascontenttopblocks}}
                                {{#showmaincontent}}
                                    {{{ output.main_content }}}
                                {{/showmaincontent}}
                                {{^showmaincontent}}
                                    <div class="sfs-shell__suppressed-main" hidden aria-hidden="true">{{{ output.main_content }}}</div>
                                {{/showmaincontent}}
                                {{#hascontentbottomblocks}}
                                    <div class="sfs-shell__blockslot sfs-shell__blockslot--content-bottom d-print-none">
                                        {{{contentbottomaddblockbutton}}}
                                        {{{contentbottomblocks}}}
                                    </div>
                                {{/hascontentbottomblocks}}
                            </main>
                            {{{ output.activity_navigation }}}
                            {{{ output.course_content_footer }}}
                        </div>
                    </div>
                    {{^hasdrawerblocks}}
                        {{#hasblocks}}
                            <aside class="sfs-shell__blocks d-print-none" aria-label="{{#str}}blocks, core{{/str}}">
                                {{{ addblockbutton }}}
                                {{{ sidepreblocks }}}
                            </aside>
                        {{/hasblocks}}
                    {{/hasdrawerblocks}}
                </div>
            </div>
            {{#footerhtml}}
                <footer class="sfs-shell__footer" aria-label="{{#str}}customfooter, theme_securefood{{/str}}">
                    {{{footerhtml}}}
                </footer>
            {{/footerhtml}}
            {{> theme_boost/footer }}
        </div>
        {{{ output.standard_after_main_region_html }}}
    </div>
</div>

<div class="sfs-shell__backdrop" data-sfs-action="backdrop" aria-hidden="true"></div>

</body>
</html>
{{#js}}
M.util.js_pending('theme_securefood/shell');
require(['theme_boost/loader', 'theme_securefood/shell', 'theme_boost/drawers'], function(Loader, Shell) {
    Shell.init();
    M.util.js_complete('theme_securefood/shell');
});
{{/js}}
