{{!
    @template theme_securefood/user_action_menu_items

    SecureFood-styled user action menu rows.

    This mirrors core/user_action_menu_items semantics but renders SFS BEM
    rows with Material icon labels injected by the shell layout.
}}
{{#items}}
    {{#link}}
        <a href="{{{url}}}" class="dropdown-item sfs-usercard-menu__item" role="menuitem" tabindex="-1">
            <span class="sfs-usercard-menu__itemicon" aria-hidden="true">
                <span class="sfs-icon">{{#sfsicon}}{{sfsicon}}{{/sfsicon}}{{^sfsicon}}chevron_right{{/sfsicon}}</span>
            </span>
            <span class="sfs-usercard-menu__itemlabel">{{title}}</span>
        </a>
    {{/link}}
    {{#submenulink}}
        <a href="#" class="carousel-navigation-link dropdown-item sfs-usercard-menu__item"
           role="menuitem" tabindex="-1" data-carousel-target-id="carousel-item-{{submenuid}}">
            <span class="sfs-usercard-menu__itemicon" aria-hidden="true">
                <span class="sfs-icon">{{#sfsicon}}{{sfsicon}}{{/sfsicon}}{{^sfsicon}}language{{/sfsicon}}</span>
            </span>
            <span class="sfs-usercard-menu__itemlabel">{{title}}</span>
            <span class="sfs-icon sfs-usercard-menu__itemchevron" aria-hidden="true">chevron_right</span>
        </a>
    {{/submenulink}}
    {{#divider}}<div class="dropdown-divider sfs-usercard-menu__divider"></div>{{/divider}}
{{/items}}
