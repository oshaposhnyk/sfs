{{!
    @template local_sfsgame/futurefood_page

    Future Food: XP hero + achievements grid (badges-backed).

    Example context (json):
    {
        "kicker": "Play & learn", "title": "Future Food", "lede": "Missions.",
        "level": 2, "xp": 650, "levelprogress": 30, "xptonext": "350 XP to the next level",
        "hasachievements": true,
        "achievements": [{"name": "First mission", "earned": true}]
    }
}}
<div class="ffg">
    <div class="ffg-head">
        <div class="ffg-head__kicker">{{kicker}}</div>
        <h2 class="ffg-head__title">{{title}}</h2>
        <p class="ffg-head__lede">{{lede}}</p>
    </div>

    <section class="ffg-hero">
        <div class="ffg-hero__body">
            <div class="ffg-hero__kicker">{{herokicker}}</div>
            <h3 class="ffg-hero__title">{{herotitle}}</h3>
            <p class="ffg-hero__lede">{{herotext}}</p>
            {{#starturl}}
                <div class="ffg-hero__actions">
                    <a class="ffg-hero__cta" href="{{starturl}}">
                        <span class="ffg-icon ffg-icon--play" aria-hidden="true"></span>
                        {{#str}}startdailymission, local_sfsgame{{/str}}
                    </a>
                </div>
            {{/starturl}}
        </div>
        <div class="ffg-hero__xp">
            <div class="ffg-hero__xphead">
                <div>
                    <div class="ffg-hero__xplabel">{{#str}}currentrank, local_sfsgame{{/str}}</div>
                    <div class="ffg-hero__levelnum">{{#str}}level, local_sfsgame{{/str}} {{level}}</div>
                </div>
                <div class="ffg-hero__xptotal">
                    <div class="ffg-hero__xplabel">{{#str}}totalxp, local_sfsgame{{/str}}</div>
                    <div class="ffg-hero__xpnum">{{xp}}</div>
                </div>
            </div>
            <div class="ffg-hero__bar" role="progressbar" aria-valuenow="{{levelprogress}}"
                 aria-valuemin="0" aria-valuemax="100" aria-label="{{#str}}level, local_sfsgame{{/str}}">
                <span class="ffg-hero__fill" style="width: {{levelprogress}}%"></span>
            </div>
            <div class="ffg-hero__next">{{xptonext}}</div>
            <div class="ffg-hero__chips">
                <span class="ffg-hero__chip">
                    <span class="ffg-icon ffg-icon--badge" aria-hidden="true"></span>{{badgecount}}
                </span>
            </div>
        </div>
    </section>

    <h3 class="ffg-achievements__title">{{#str}}achievements, local_sfsgame{{/str}}</h3>
    {{^hasachievements}}
        <div class="alert alert-info">{{#str}}noachievements, local_sfsgame{{/str}}</div>
    {{/hasachievements}}
    <div class="ffg-achievements">
        {{#achievements}}
            <div class="ffg-ach {{^earned}}ffg-ach--locked{{/earned}}">
                <span class="ffg-ach__badge" aria-hidden="true">
                    {{#imageurl}}<img class="ffg-ach__img" src="{{imageurl}}" alt="">{{/imageurl}}
                </span>
                <span class="ffg-ach__name">{{name}}</span>
                <span class="ffg-ach__state">
                    {{#earned}}{{#xplabel}}<span class="ffg-ach__xp">{{xplabel}}</span>{{/xplabel}}{{/earned}}
                    {{^earned}}{{#str}}locked, local_sfsgame{{/str}}{{/earned}}
                </span>
            </div>
        {{/achievements}}
    </div>

    {{#missions.0}}
        <h3 class="ffg-missions__title">{{#str}}missionstitle, local_sfsgame{{/str}}</h3>
        <div class="ffg-missions">
            {{#missions}}
                <article class="ffg-mission">
                    <div class="ffg-mission__thumb ffg-mission__thumb--{{variant}}">
                        {{#badge}}<span class="ffg-mission__badge">{{badge}}</span>{{/badge}}
                        {{#url}}<span class="ffg-mission__play" aria-hidden="true"></span>{{/url}}
                        {{#duration}}<span class="ffg-mission__duration">{{duration}}</span>{{/duration}}
                    </div>
                    <div class="ffg-mission__body">
                        <div class="ffg-mission__tags">
                            {{#tags}}<span class="ffg-mission__tag">{{name}}</span>{{/tags}}
                        </div>
                        <h4 class="ffg-mission__name">{{title}}</h4>
                        <p class="ffg-mission__text">{{text}}</p>
                        <div class="ffg-mission__foot">
                            <span class="ffg-mission__xp">+{{xp}} {{#str}}xp, local_sfsgame{{/str}}</span>
                            {{#url}}
                                <a class="ffg-mission__action btn btn-primary" href="{{url}}">
                                    {{#str}}startmission, local_sfsgame{{/str}}
                                </a>
                            {{/url}}
                        </div>
                    </div>
                </article>
            {{/missions}}
        </div>
    {{/missions.0}}
</div>