<section class="learning-plan">
    {{! The plan name is already the page heading (set_heading); the template
        only carries the description and the management actions. }}
    <div class="learning-plan__header">
        {{#description}}<div class="learning-plan__intro">{{{description}}}</div>{{/description}}
        <div class="learning-plan__actions">
            <a class="btn btn-secondary learning-plan__action-btn" href="{{editurl}}">{{labeledit}}</a>
            <a class="btn btn-secondary learning-plan__action-btn" href="{{cohortsurl}}">{{labelmanagecohorts}}</a>
            <a class="btn btn-primary learning-plan__action-btn" href="{{enrolurl}}">{{labelmanageenrolments}}</a>
        </div>
    </div>

    <h3>{{addcoursetitle}}</h3>
    {{{addcourseform}}}

    <h3>{{labelcourse}}</h3>
    {{#hascoursereorder}}
        <form id="{{reorderformid}}" method="post" action="{{reorderurl}}" class="learning-plan__reorder-form">
            <input type="hidden" name="sesskey" value="{{sesskey}}">
            <input type="hidden" name="action" value="reorder">
            <input type="hidden" id="{{reorderinputid}}" name="orderedcourseids" value="">
            <input type="hidden" id="{{stageinputid}}" name="stageids" value="">
        </form>
    {{/hascoursereorder}}
    {{#hascourses}}
        <div id="{{courselistid}}" class="learning-plan__stage-groups">
            {{#stagegroups}}
                <section class="learning-plan__stage-group">
                    {{#showheadings}}
                        <div class="learning-plan__stage-heading">
                            <span class="learning-plan__stage-heading-name">{{heading}}</span>
                            <span class="learning-plan__stage-heading-count">{{countlabel}}</span>
                            {{#isstage}}
                                <form class="learning-plan__stage-rename" method="post" action="{{stageformurl}}">
                                    <input type="hidden" name="sesskey" value="{{sesskey}}">
                                    <input type="hidden" name="action" value="renamestage">
                                    <input type="hidden" name="stageid" value="{{stageid}}">
                                    <label class="visually-hidden" for="lp-rename-{{stageid}}">{{labelrenamestage}}</label>
                                    <input id="lp-rename-{{stageid}}" class="form-control form-control-sm learning-plan__stage-rename-input"
                                           type="text" name="stagename" value="{{heading}}" maxlength="255">
                                    <button class="btn btn-secondary btn-sm" type="submit">{{labelrenamestage}}</button>
                                </form>
                            {{/isstage}}
                        </div>
                    {{/showheadings}}
                    <ul class="learning-plan__course-list learning-plan__stage-list" data-stageid="{{stageid}}">
                        {{#courses}}
                            <li class="learning-plan__course-item" data-courseid="{{courseid}}" data-name="{{name}}">
                                <div class="learning-plan__course-row {{#stagename}}learning-plan__course-row--staged{{/stagename}}">
                                    <div class="learning-plan__course-main">
                                        <span class="learning-plan__course-handle">{{{draghandle}}}</span>
                                        <div class="learning-plan__course-title">
                                            <strong>{{order}}.</strong> <span class="learning-plan__course-name">{{name}}</span>
                                        </div>
                                    </div>
                                    <form class="learning-plan__stage-form" method="post" action="{{stageformurl}}">
                                        <input type="hidden" name="sesskey" value="{{sesskey}}">
                                        <input type="hidden" name="action" value="setstage">
                                        <input type="hidden" name="courseid" value="{{courseid}}">
                                        <label class="visually-hidden" for="lp-stage-{{courseid}}">{{labelstage}}</label>
                                        <input id="lp-stage-{{courseid}}" class="form-control form-control-sm learning-plan__stage-input"
                                               type="text" name="stagename" value="{{stagename}}" maxlength="255"
                                               placeholder="{{stageplaceholder}}">
                                        <button class="btn btn-secondary btn-sm" type="submit">{{labelsavestage}}</button>
                                    </form>
                                    <div class="learning-plan__actions">
                                        <a class="btn btn-icon learning-plan__icon-action" href="{{moveupurl}}" title="{{labelmoveup}}" aria-label="{{labelmoveup}}">
                                            {{{moveupicon}}}
                                        </a>
                                        <a class="btn btn-icon learning-plan__icon-action" href="{{movedownurl}}" title="{{labelmovedown}}" aria-label="{{labelmovedown}}">
                                            {{{movedownicon}}}
                                        </a>
                                        <a class="btn btn-danger btn-sm" href="{{removeurl}}">{{labelremove}}</a>
                                    </div>
                                </div>
                            </li>
                        {{/courses}}
                    </ul>
                </section>
            {{/stagegroups}}
        </div>
    {{/hascourses}}
    {{^hascourses}}
        <p>{{nocourses}}</p>
    {{/hascourses}}

    <h3>{{labelmemberships}}</h3>
    {{#hasmembers}}
        <div class="learning-plan__membership-table">
            <table class="generaltable">
                <thead>
                    <tr>
                        <th>{{labeluser}}</th>
                        <th>{{labelprogress}}</th>
                        <th>{{labelcompletedcourses}}</th>
                        <th>{{labelinprogresscourses}}</th>
                        <th>{{labelnotstartedcourses}}</th>
                        <th>{{labelnextcourse}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#members}}
                        <tr>
                            <td>
                                <div class="learning-plan__user">
                                    <a class="learning-plan__user-link" href="{{userprofileurl}}">
                                        {{{userpicture}}}
                                        <span>{{fullname}}</span>
                                    </a>
                                </div>
                            </td>
                            <td>
                                <div class="learning-plan__progress">
                                    <progress class="learning-plan__progress-bar" max="100" value="{{progresspercent}}"></progress>
                                    <span>{{progresslabel}}</span>
                                </div>
                            </td>
                            <td>{{completedcourses}}</td>
                            <td>{{inprogresscourses}}</td>
                            <td>{{notstartedcourses}}</td>
                            <td>
                                {{#nextcourseurl}}
                                    <a href="{{nextcourseurl}}">{{nextcourse}}</a>
                                {{/nextcourseurl}}
                                {{^nextcourseurl}}
                                    {{nextcourse}}
                                {{/nextcourseurl}}
                            </td>
                        </tr>
                    {{/members}}
                </tbody>
            </table>
        </div>
    {{/hasmembers}}
    {{^hasmembers}}
        <p>{{nomembers}}</p>
    {{/hasmembers}}
</section>
