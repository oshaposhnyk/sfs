<section class="learning-plan">
    <h2>{{title}}</h2>

    {{#hasrows}}
        <div class="learning-plan__membership-table">
            <table class="generaltable">
                <thead>
                    <tr>
                        <th>{{title}}</th>
                        <th>{{labelprogress}}</th>
                        <th>{{labelnextcourse}}</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    {{#rows}}
                        <tr>
                            <td>{{planname}}</td>
                            <td>{{progresslabel}}</td>
                            <td>{{nextcourse}}</td>
                            <td><a href="{{viewurl}}">{{viewlabel}}</a></td>
                        </tr>
                    {{/rows}}
                </tbody>
            </table>
        </div>
    {{/hasrows}}
    {{^hasrows}}
        <p>{{empty}}</p>
    {{/hasrows}}
</section>

