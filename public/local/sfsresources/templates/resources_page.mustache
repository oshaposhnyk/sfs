{{!
    @template local_sfsresources/resources_page

    Resources & Standards: document library rows.

    Example context (json):
    {
        "kicker": "Reference library", "title": "Resources & Standards",
        "lede": "Protocols and templates.", "library": "Document library",
        "hasdocuments": true,
        "documents": [{"title": "HACCP Protocol v2.1", "sub": "Cold chain",
            "audience": "Director", "kind": "pdf", "kindlabel": "PDF",
            "updated": "2 days ago", "url": "#"}]
    }
}}
<div class="sfsres">
    <div class="sfsres__head">
        <div class="sfsres__kicker">{{kicker}}</div>
        <h2 class="sfsres__title">{{title}}</h2>
        <p class="sfsres__lede">{{lede}}</p>
    </div>

    {{#hasstats}}
        <div class="sfsres__stats">
            {{#stats}}
                <div class="sfsres-stat sfsres-stat--{{variant}}">
                    <span class="sfsres-stat__label">{{label}}</span>
                    <span class="sfsres-stat__value">{{value}}{{#suffix}}<span class="sfsres-stat__suffix">{{suffix}}</span>{{/suffix}}</span>
                    <progress class="sfsres-stat__bar" value="{{percent}}" max="100"
                              aria-label="{{label}}">{{percent}}%</progress>
                    {{#sub}}<span class="sfsres-stat__sub">{{sub}}</span>{{/sub}}
                </div>
            {{/stats}}
        </div>
    {{/hasstats}}

    {{#hastools}}
        <div class="sfsres__tools">
            {{#tools}}
                <a class="sfsres-tool" href="{{url}}">
                    <span class="sfsres-tool__icon sfsres-tool__icon--{{key}}" aria-hidden="true"></span>
                    <span class="sfsres-tool__title">{{title}}</span>
                    <span class="sfsres-tool__desc">{{desc}}</span>
                    <span class="sfsres-tool__count">
                        <span class="sfsres-tool__countlabel">{{countlabel}}</span>
                        <strong class="sfsres-tool__countnum">{{count}}</strong>
                    </span>
                </a>
            {{/tools}}
        </div>
    {{/hastools}}

    <section class="sfsres__card">
        <div class="sfsres__libraryhead">
            <h3 class="sfsres__library">{{library}}</h3>
            <div class="sfsres__filters">
                {{#filters}}
                    <a class="sfsres__filter {{#active}}sfsres__filter--active{{/active}}" href="{{url}}"
                       {{#active}}aria-current="true"{{/active}}>{{label}}</a>
                {{/filters}}
            </div>
        </div>
        {{^hasdocuments}}
            <div class="alert alert-info">{{#str}}nodocuments, local_sfsresources{{/str}}</div>
        {{/hasdocuments}}
        <div class="sfsres__list">
            {{#documents}}
                <div class="sfsres-doc">
                    <span class="sfsres-doc__icon sfsres-doc__icon--{{kind}}">{{kindlabel}}</span>
                    <span class="sfsres-doc__meta">
                        <span class="sfsres-doc__title">{{title}}</span>
                        {{#sub}}<span class="sfsres-doc__sub">{{sub}}</span>{{/sub}}
                    </span>
                    {{#audience}}<span class="sfsres-doc__audience">{{audience}}</span>{{/audience}}
                    {{#updated}}<span class="sfsres-doc__updated">{{updated}}</span>{{/updated}}
                    {{#url}}
                        <a class="sfsres-doc__open" href="{{url}}" aria-label="{{#str}}open, local_sfsresources{{/str}}: {{title}}">
                            <span class="sfsres-doc__opentext">{{#str}}open, local_sfsresources{{/str}}</span>
                        </a>
                    {{/url}}
                </div>
            {{/documents}}
        </div>
    </section>
</div>
